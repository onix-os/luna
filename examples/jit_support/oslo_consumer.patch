 impl Engine {
     pub fn new() -> Self {
+        let lua = Lua::full();
+        #[cfg(feature = "luna-jit-bench")]
+        let lua = {
+            let mut lua = lua;
+            let mode = match std::env::var("LUNA_OSLO_JIT_MODE").as_deref() {
+                Ok("auto") => luna::JitMode::Auto,
+                Ok("off") | Err(_) => luna::JitMode::Off,
+                _ => panic!("invalid consumer benchmark mode"),
+            };
+            lua.set_jit_config(luna::JitConfig {
+                mode,
+                ..Default::default()
+            })
+            .expect("consumer JIT configuration");
+            lua
+        };
         Engine {
-            lua: RefCell::new(Lua::full()),
+            lua: RefCell::new(lua),
             chunk: RefCell::new("?".to_string()),
             varargs: RefCell::new(Vec::new()),
         }
     }
 
+    pub fn luna_bench_stats(&self) -> (bool, [u64; 5]) {
+        #[cfg(feature = "luna-jit-bench")]
+        {
+            let stats = self.lua.borrow().jit_stats();
+            (
+                true,
+                [
+                    stats.native_entries,
+                    stats.native_instructions,
+                    stats.compilation_requests,
+                    stats.code_bytes as u64,
+                    stats.metadata_bytes as u64,
+                ],
+            )
+        }
+        #[cfg(not(feature = "luna-jit-bench"))]
+        {
+            (false, [0; 5])
+        }
+    }
+
     /// Name the source that is about to run, for error positions.
     pub fn set_chunk(&self, name: &str) {
         *self.chunk.borrow_mut() = name.to_string();
